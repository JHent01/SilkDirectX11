<mahx:CustomDialog x:Class="SilkDirectX11.Views.CamersSettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SilkDirectX11.Views"
        mc:Ignorable="d"
        xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:mahx="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:enums="clr-namespace:SilkDirectX11.Enums"
        xmlns:convert="clr-namespace:SilkDirectX11.Converters"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Width="700"  >
    
    
    <Grid >
         
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="auto" />
        </Grid.ColumnDefinitions>

        <ListBox Width="200" Margin="0,30,90,00" ItemsSource="{Binding CameraList}" SelectedItem="{Binding VideoHost}" Grid.Column="0" >
            <ListBox.ItemTemplate>
                <DataTemplate>
                    
                    
                    <!--<Label Content="{Binding Item.CameraName}" />-->
                    <CheckBox  Content="{Binding Item.CameraName}" IsChecked="{Binding IsSelected}" Margin="10,0,0,0"   />
                    <!--IsChecked="{Binding IsSelected, Mode=TwoWay}"-->
                    <!--Content="{Binding Item.CameraName}" IsChecked="{Binding IsSelected}"-->

                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
         
       

        <Grid Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>

                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />

                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />

                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            
            <Label Grid.Row="0" Grid.Column="0" Content="Brightness:" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5" />
            <Label Grid.Row="1" Grid.Column="0" Content="Contrast:" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5" />
            <Label Grid.Row="2" Grid.Column="0" Content="Hue:" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5" />
            <Label Grid.Row="3" Grid.Column="0" Content="Saturation:" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5" />
            <Label Grid.Row="4" Grid.Column="0" Content="NoiseReduction:" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5" />
            <Label Grid.Row="5" Grid.Column="0" Content="EdgeEnhancement:" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5" />
            <Label Grid.Row="6" Grid.Column="0" Content="AnamorphicScaling:" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5" />
            <Label Grid.Row="7" Grid.Column="0" Content="StereoAdjustment:" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5" />

            <Label Grid.Row="8" Grid.Column="0" Content="Rotation:" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5" />
            <ComboBox Grid.Row="8" Grid.Column="1" Width="120" Height="30" Margin="5" HorizontalAlignment="Left"
                      ItemsSource="{Binding Source={convert:ConvertEnum EnumType={x:Type enums:EnumRotation}}}"
                      SelectedItem="{Binding Rotation}" />
                
            <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding SliderValue}" Width="200" Height="30" Margin="5"  />
            <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding SliderValue}" Width="200" Height="30" Margin="5"  />
            <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding SliderValue}" Width="200" Height="30"  Margin="5" />
            <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding SliderValue}" Width="200" Height="30"  Margin="5" />
            <Slider Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding SliderValue}" Width="200" Height="30"  Margin="5" />
            <Slider Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding SliderValue}" Width="200" Height="30"  Margin="5" />
            <Slider Grid.Row="6" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding SliderValue}" Width="200" Height="30"  Margin="5" />
            <Slider Grid.Row="7" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding SliderValue}" Width="200" Height="30"  Margin="5" />
            
            <Button  Grid.Row="9" Grid.Column="0" Content="Save" Margin="5" HorizontalAlignment="Right"  Width="100" Height="30" Command="{Binding CloseComaand}" />
            <Button  Grid.Row="9" Grid.Column="1" Content="Close" Margin="5" HorizontalAlignment="Left"  Width="100" Height="30" Command="{Binding CloseComaand}" />
        </Grid>
    </Grid>
</mahx:CustomDialog>
