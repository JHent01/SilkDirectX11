<Window x:Class="SilkDirectX11.Views.SettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SilkDirectX11.Views"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        WindowStyle="None"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="True"
        ShowInTaskbar="False"
         AllowsTransparency="True"
        Title="SettingsView" Height="400" Width="700" Background="Transparent" >
    <i:Interaction.Triggers>
        <i:EventTrigger>
            <i:InvokeCommandAction Command="{Binding LoadedCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Border CornerRadius="25" BorderThickness="5"   Background="#252525">
        <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
               
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
                <RowDefinition Height="100"/>
                <RowDefinition Height="200" />
            </Grid.RowDefinitions>
            <Label Grid.Column="0" Grid.ColumnSpan="4" Content="Settings Page" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="32" Margin="0,25,0,0"/>
            <Label Content="Select Forder " Grid.Row="1" Grid.Column="0" Width="105" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="16" Margin="15"/>
            <TextBox x:Name="Path" Text="{Binding SavePathSettings}"  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10" MinWidth="200"  Width="490" Grid.Row="1" Grid.Column="1"  IsReadOnly="True"/>
            <Button Content="..." Grid.Column="2" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10" Width="30" Command="{Binding SelectForderForCamers}"   />
            <Grid Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="2" Margin="15" HorizontalAlignment="Right"  >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="Save" Grid.Column="0"   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="15" Width="100" Command="{Binding SaveSettingsCommand}" />
                <Button Content="Cansel" Command="{Binding CanselCommand}" Width="100"   Margin="15"  Grid.Column="1"   HorizontalAlignment="Right" VerticalAlignment="Bottom"  />

            </Grid>

        </Grid>
    </Border>
</Window>
